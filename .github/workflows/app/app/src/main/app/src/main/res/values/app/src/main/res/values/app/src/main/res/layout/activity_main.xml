<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1877F2"
        app:title="AutoPost Pro"
        app:titleTextColor="#FFF"
        app:subtitle="Smart Video Scheduler"
        app:subtitleTextColor="#CCFFFFFF"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Login Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔐 Facebook Login"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Facebook দিয়ে লগইন"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#1877F2"/>
                    <TextView
                        android:id="@+id/tvLoginStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Main Section (hidden until login) -->
            <LinearLayout
                android:id="@+id/mainSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Page Info -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvPageName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Page"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLogout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="লগআউট"
                            style="@style/Widget.MaterialComponents.Button.TextButton"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stats -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">
                        <LinearLayout android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tvTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0" android:textSize="20sp"
                                android:textStyle="bold" android:textColor="#1877F2"/>
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="মোট" android:textSize="11sp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tvDone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0" android:textSize="20sp"
                                android:textStyle="bold" android:textColor="#4CAF50"/>
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="সম্পন্ন" android:textSize="11sp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tvFail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0" android:textSize="20sp"
                                android:textStyle="bold" android:textColor="#F44336"/>
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ব্যর্থ" android:textSize="11sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Match Info -->
                <TextView
                    android:id="@+id/tvMatchInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#E8F5E9"
                    android:padding="12dp"
                    android:textColor="#2E7D32"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp"/>

                <!-- File Selection -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📁 ফাইল সিলেক্ট"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVideos"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="🎬 ভিডিও সিলেক্ট (30-50টি)"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_marginBottom="4dp"/>
                        <TextView android:id="@+id/tvVideoStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="কোনো ভিডিও নেই"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTitles"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="📝 টাইটেল/ডেসক্রিপশন ফাইল"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_marginBottom="4dp"/>
                        <TextView android:id="@+id/tvTitleStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="কোনো ফাইল নেই"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Schedule -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏰ শিডিউল"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTime"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="📅 শুরুর সময় সেট করুন"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_marginBottom="4dp"/>
                        <TextView android:id="@+id/tvTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="সময় সেট হয়নি"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="গ্যাপ (মিনিট):" android:textSize="14sp"/>
                            <EditText android:id="@+id/etGap"
                                android:layout_width="70dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:inputType="number"
                                android:text="30"
                                android:textAlignment="center"
                                android:background="@android:drawable/editbox_background"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Video List -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📋 অটো-ম্যাচড ভিডিও লিস্ট"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvVideos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="#FFF"
        android:elevation="8dp"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSchedule"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="⏰ শিডিউল"
            android:backgroundTint="#1877F2"
            android:layout_marginEnd="6dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🚀 এখনই শুরু"
            android:backgroundTint="#4CAF50"/>
    </LinearLayout>
</LinearLayout>
